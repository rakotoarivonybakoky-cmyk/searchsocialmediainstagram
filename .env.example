
# URI MongoDB complète avec identifiants
MONGODB_URI=mongodb://votre_utilisateur:votre_mot_de_passe@57.129.18.234:27017/leadfeeder-social-accounts?authSource=leadfeeder-social-accounts

# Nom de la base existante (NE PAS MODIFIER)
MONGODB_DB_NAME=leadfeeder-social-accounts

# Nom de la collection existante (NE PAS MODIFIER)
MONGODB_COLLECTION_NAME=adding_social_accounts

# ------------------------------------------------------------------------------
# 2. FOURNISSEUR DE RECHERCHE (SEARCH PROVIDER)
# ------------------------------------------------------------------------------
# Options disponibles :
#   - hybrid          : 1) Tente d'abord d'extraire depuis le site officiel de l'entreprise
#                       2) Si absent, utilise le moteur de recherche configuré (DuckDuckGo ou API)
#                       (RECOMMANDÉ : 100% gratuit, haute confiance, économique)
#   - website_scraper : Analyse UNIQUEMENT le site web officiel de l'entreprise (domains / url).
#                       Aucune API externe requise, fiabilité maximale.
#   - duckduckgo      : Recherche web via DuckDuckGo (sans clé API).
#   - google          : Utilise l'API Google Custom Search (nécessite API Key + Engine ID).
#   - serpapi         : Utilise SerpApi pour les requêtes Google (nécessite SERPAPI_KEY).
SEARCH_PROVIDER=hybrid

# Clés API pour moteurs de recherche tiers (optionnel si hybrid ou duckduckgo est utilisé) :
# Pour Google Custom Search API : https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Pour SerpApi : https://serpapi.com/
SERPAPI_KEY=

# ------------------------------------------------------------------------------
# 3. CONTRÔLE DE DÉBIT ET FIABILITÉ
# ------------------------------------------------------------------------------
# Délai entre requêtes web en secondes (pour éviter les blocages de taux / rate-limits)
RATE_LIMIT_DELAY=1.0

# Timeout par requête web en secondes
REQUEST_TIMEOUT=8

# Nombre de tentatives en cas d'erreur réseau
MAX_RETRIES=2

# Seuil de confiance minimum pour l'écriture en base :
# HIGH   : Seuls les liens confirmés par le site officiel ou concordants à 100% sont enregistrés (DÉFAUT OBLIGATOIRE).
# MEDIUM : Enregistre aussi les liens trouvés par moteur avec forte ressemblance (Non recommandé sans revue).
CONFIDENCE_THRESHOLD=HIGH

# Niveau de logs : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
